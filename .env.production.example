# Production environment — cPanel, MySQL.
#
# Copy to .env on the server and fill in. See docs/DEPLOY.md.
# Never commit the filled-in copy: .env is in .gitignore for a reason.

APP_NAME=TableReserved
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Vouchers, QR codes and webhook addresses are all built from this. A wrong
# value produces QR codes that point nowhere, and by then they are printed.
APP_URL=https://table.armenisnick.gr

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Keep the log small on shared hosting; `daily` rotates, `single` grows for ever.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# From cPanel -> MySQL Databases. The user needs ALL PRIVILEGES on the database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, queue -------------------------------------------------
# All on the database: no Redis on shared hosting, and one fewer thing to go
# wrong (SPEC §21.2).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# `database` needs the queue worker cron from docs/DEPLOY.md §5. If the host
# will not run one, set this to `sync`: the guest waits a couple of seconds
# longer on the confirmation screen, and nothing is lost.
QUEUE_CONNECTION=database

# --- Mail -------------------------------------------------------------------
# Brevo -> SMTP & API. The login is an email address, the password is the SMTP
# key, not the account password.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=

# Must be on a domain we control, with SPF, DKIM and DMARC in place. The
# venue's own name goes in the display name and its address in Reply-To, both
# set per message (SPEC §10.3).
MAIL_FROM_ADDRESS=noreply@armenisnick.gr
MAIL_FROM_NAME="${APP_NAME}"

# Becomes part of the delivery-webhook URL, so make it long and random:
#   php artisan key:generate --show
MAIL_WEBHOOK_SECRET=

# --- Subscription billing — OUR keys, not a venue's -------------------------
# These charge venues their subscription into *our* account. The keys in the
# dashboard's Payments screen are a different thing entirely: they belong to
# each venue and charge that venue's own guests into that venue's own account.
# Mixing the two up in either direction is the worst bug this application
# could have, which is why they never share a name or a table (SPEC §4.3).
#
# Leave these empty and everything still works — the Billing page says online
# payment is not switched on. Filling them in is what turns the buttons on.
BILLING_PROVIDER=stripe

# Deliberately separate from APP_ENV: staging against live keys charges real
# cards, production against test keys takes no money while looking like it has.
BILLING_MODE=test

BILLING_STRIPE_SECRET=
BILLING_STRIPE_WEBHOOK_SECRET=

BILLING_PAYPAL_CLIENT_ID=
BILLING_PAYPAL_CLIENT_SECRET=

# Without this a PayPal webhook cannot be verified and is ignored — which
# looks exactly like silence until a paying account lapses.
BILLING_PAYPAL_WEBHOOK_ID=

# --- Media ------------------------------------------------------------------
# `public` needs `php artisan storage:link`. Object storage comes later
# (SPEC §30.1).
MEDIA_DISK=public
FILESYSTEM_DISK=local

# --- Error tracking ---------------------------------------------------------
# Empty until the Sentry account exists (SPEC §30.2).
SENTRY_LARAVEL_DSN=

# Which deploy a report came from — the most useful field on it, because it
# answers "did my change cause this" without having to remember when the
# change went out. Set it from the deploy script, e.g.
#   SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=

# Falls back to APP_ENV. Set it only when staging and production report into
# the same Sentry project and have to be told apart (SPEC §30.3).
SENTRY_ENVIRONMENT=

# Performance monitoring off. Traces spend a free quota in days, and the
# question they answer — which query is slow — is not the one worth paying
# for yet. The one worth paying for is "did a booking fail", which is an
# error, not a trace.
SENTRY_TRACES_SAMPLE_RATE=0.0

VITE_APP_NAME="${APP_NAME}"
